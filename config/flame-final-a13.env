CONFIG_ENV=config/flame-final-a13.env

KERNEL_SOURCE=https://android.googlesource.com/kernel/msm
KERNEL_SOURCE_BRANCH=android-msm-coral-4.14-android13
KERNEL_CONFIG=floral_defconfig
KERNEL_IMAGE_NAME=Image.lz4
ARCH=arm64
KERNEL_NAME=
ADD_LOCALVERSION_TO_FILENAME=false
EXTRA_CMDS:LD=ld.lld KCFLAGS=-Wno-error=declaration-after-statement
CUSTOM_CMDS:CLANG_TRIPLE=aarch64-linux-gnu-

CLANG_BRANCH=master-kernel-build-2021
CLANG_VERSION=r416183b
USE_CUSTOM_CLANG=false
USE_LLVM=false
ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true

KSU_VARIANT=sukisu-ultra
KSU_REF=builtin
KSU_HOOK_MODE=manual
KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=

ENABLE_SUSFS=false
SUSFS_BRANCH=auto
ENABLE_PATH_UMOUNT=false
ENABLE_HIDE_STUFF=false
ENABLE_KPM=false

ADD_KPROBES_CONFIG=false
ADD_OVERLAYFS_CONFIG=true
DISABLE_LTO=false
DISABLE_CC_WERROR=false
EXTRA_DEFCONFIG=CONFIG_LOCALVERSION="-g6ef255005cea-ab9062920" CONFIG_LOCALVERSION_AUTO=n CONFIG_KALLSYMS=y CONFIG_KALLSYMS_ALL=y

USE_CUSTOM_ANYKERNEL3=false
NEED_DTBO=false
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=

ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
